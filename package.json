{
  "name": "podcast-music-site",
  "version": "1.2a9078bf8",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run db:generate && next build --no-lint",
    "postbuild": "echo 'Build complete'",
    "postinstall": "if [ \"$NODE_ENV\" != \"production\" ]; then npm run check-env || true; fi",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:all": "tsx --test lib/*.test.ts lib/*/*.test.ts",
    "check:conformance": "tsx scripts/conformance.ts",
    "relay": "node scripts/local-relay.mjs",
    "dev:isolated": "NEXT_PUBLIC_NOSTR_RELAYS=ws://127.0.0.1:7777 next dev",
    "seed:relay": "node scripts/seed-local-relay.mjs",
    "e2e:favorites": "tsx scripts/e2e-favorites.ts",
    "check-env": "node scripts/check-env.js",
    "test:blob-cache": "node --experimental-strip-types --test scripts/test-audio-blob-cache.ts",
    "test:downloads": "tsx --test lib/downloads/*.test.ts",
    "update-version": "node scripts/auto-version-update.js",
    "deploy": "./scripts/deploy.sh",
    "auto-deploy": "npm run update-version && ./scripts/auto-deploy.sh",
    "check-albums": "./scripts/check-album-issues.sh",
    "test-rss-parser": "node scripts/test-rss-parser.js",
    "test-add-playlist": "node scripts/test-add-playlist-endpoint.js",
    "reparse-database": "node scripts/reparse-main-branch-database.js",
    "reparse-database-robust": "node scripts/reparse-database-robust.js",
    "android:sync": "npx cap sync android",
    "android:icons": "npx --yes @capacitor/assets@3.0.5 generate --android --iconBackgroundColor '#1f2937' --splashBackgroundColor '#1f2937'",
    "android:release": "cd android && ./gradlew assembleRelease",
    "android:debug": "cd android && ./gradlew assembleDebug",
    "db:generate": "./node_modules/.bin/prisma generate",
    "db:migrate": "./node_modules/.bin/prisma migrate deploy",
    "db:migrate:dev": "./node_modules/.bin/prisma migrate dev",
    "db:push": "./node_modules/.bin/prisma db push",
    "db:studio": "./node_modules/.bin/prisma studio",
    "db:reset": "./node_modules/.bin/prisma migrate reset",
    "auto-playlist-workflow": "node scripts/automated-playlist-workflow.js",
    "discover-playlist-feeds": "node scripts/auto-discover-playlist-feeds.js",
    "perf:db": "npx tsx scripts/perf-db.ts",
    "perf:api": "npx tsx scripts/perf-api.ts",
    "perf:memory": "node --expose-gc --import tsx scripts/perf-memory.ts",
    "perf:lighthouse": "npx tsx scripts/perf-lighthouse.ts",
    "perf:all": "npm run perf:db && npm run perf:api && npm run perf:memory"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@getalby/bitcoin-connect": "^3.12.2",
    "@prisma/client": "6.19.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/xml2js": "^0.4.14",
    "@webbtc/webln-types": "^3.0.0",
    "@xmldom/xmldom": "^0.9.12",
    "autoprefixer": "^10.4.24",
    "axios": "^1.20.0",
    "bech32": "^2.0.0",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.3.1",
    "dotenv-safe": "^9.1.0",
    "fast-xml-parser": "^5.3.7",
    "fluent-ffmpeg": "^2.1.3",
    "hls.js": "^1.6.15",
    "lucide-react": "^0.294.0",
    "next": "^15.5.26",
    "next-pwa": "^5.6.0",
    "node-fetch": "^2.7.0",
    "nostr-login": "^1.7.12",
    "nostr-tools": "^2.25.2",
    "postcss": "^8.5.28",
    "postcss-import": "^16.1.1",
    "postcss-preset-env": "^11.1.3",
    "prisma": "6.19.3",
    "process": "^0.11.10",
    "qrcode.react": "^4.2.0",
    "react": "^18",
    "react-dom": "^18",
    "rss-parser": "^3.13.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.19",
    "typescript": "^5",
    "ws": "^8.21.3",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@next/bundle-analyzer": "^16.0.3",
    "@types/js-yaml": "^4.0.9",
    "@types/ws": "^8.18.1",
    "eslint": "^8",
    "eslint-config-next": "^15.5.26",
    "lighthouse": "^12.8.2",
    "tsx": "^4.21.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "buildTime": "2025-07-30T00:17:52.716Z"
}
